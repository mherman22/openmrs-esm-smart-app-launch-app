{
  "$schema": "https://json.openmrs.org/routes.schema.json",
  "backendDependencies": {
    "fhir2": ">=4.2.0",
    "smartonfhir": ">=2.0.0-0"
  },
  "pages": [
    {
      "route": "smart/select-patient",
      "component": "root",
      "online": true
    }
  ],
  "extensions": [
    {
      "name": "launch-smart-app-action",
      "component": "launchAppAction",
      "slot": "patient-actions-slot",
      "online": true,
      "offline": false
    }
  ],
  "modals": [
    {
      "name": "smart-apps-modal",
      "component": "smartAppsModal"
    }
  ]
}
